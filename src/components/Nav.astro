---
import Icon from './Icon.astro';
import { NAV, REPO, VERSION } from '../lib/site';
---

<header class="fixed top-0 left-0 z-70 w-full bg-surface" style="height: var(--nav-h)">
  <div class="shell flex h-full items-center gap-3">
    <a href="#top" class="group flex shrink-0 items-center gap-3" aria-label="Fullstack DevTools, inicio">
      <svg width="30" height="30" viewBox="0 0 32 32" aria-hidden="true" class="shrink-0">
        <rect width="32" height="32" fill="var(--c-blue-deep)"></rect>
        <rect x="4" y="6" width="7" height="7" fill="var(--c-blue)"></rect>
        <rect x="12.5" y="12.5" width="7" height="7" fill="var(--c-cyan)"></rect>
        <rect x="21" y="19" width="7" height="7" fill="var(--c-green)"></rect>
        <rect x="10" y="9" width="4" height="2" fill="var(--c-ink)"></rect>
        <rect x="18.5" y="15.5" width="4" height="2" fill="var(--c-ink)"></rect>
      </svg>
      <span class="leading-none">
        <span class="block text-[15px] font-bold tracking-[-0.02em] text-ink">Fullstack</span>
        <span class="label block text-blue">DevTools</span>
      </span>
    </a>

    <span class="label hidden shrink-0 bg-surface-3 px-2 py-1 text-ink-2 md:inline">v{VERSION}</span>

    <nav class="ml-auto hidden items-center gap-1 xl:flex" aria-label="Secciones">
      {
        NAV.map((item) => (
          <a
            href={`#${item.id}`}
            data-spy={item.id}
            class="label px-2.5 py-2 whitespace-nowrap text-ink-2 transition-colors duration-150 hover:bg-surface-3 hover:text-ink"
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="ml-auto flex shrink-0 items-center gap-2 xl:ml-3">
      <button
        type="button"
        data-theme-toggle
        class="flex h-10 w-10 items-center justify-center bg-surface-3 text-ink transition-colors duration-150 hover:bg-blue hover:text-on-accent"
        aria-label="Cambiar entre modo oscuro y claro"
        title="Cambiar tema"
      >
        <span class="hidden light:block"><Icon name="moon" size={18} /></span>
        <span class="block light:hidden"><Icon name="sun" size={18} /></span>
      </button>

      <a
        href={REPO}
        target="_blank"
        rel="noreferrer noopener"
        class="hidden h-10 items-center gap-2 bg-blue px-4 text-on-accent transition-colors duration-150 hover:bg-ink hover:text-bg sm:flex"
      >
        <Icon name="github" size={17} />
        <span class="label">GitHub</span>
      </a>

      <button
        id="menu-btn"
        type="button"
        class="flex h-10 w-10 items-center justify-center bg-surface-3 text-ink transition-colors duration-150 hover:bg-blue hover:text-on-accent xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Abrir menú de secciones"
      >
        <Icon name="menu" size={18} />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="bg-surface-2 xl:hidden" hidden>
    <nav class="shell grid grid-cols-2 gap-[2px] py-[2px]" aria-label="Secciones en móvil">
      {
        NAV.map((item, i) => (
          <a
            href={`#${item.id}`}
            data-spy={item.id}
            class={`label bg-surface px-3 py-4 text-ink-2 hover:bg-blue hover:text-on-accent ${
              i === NAV.length - 1 && NAV.length % 2 === 1 ? 'col-span-2' : ''
            }`}
          >
            {item.label}
          </a>
        ))
      }
      <a
        href={REPO}
        target="_blank"
        rel="noreferrer noopener"
        class="label col-span-2 flex items-center justify-center gap-2 bg-blue px-3 py-4 text-on-accent"
      >
        <Icon name="github" size={16} /> Repositorio en GitHub
      </a>
    </nav>
  </div>
</header>
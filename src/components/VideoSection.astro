---
import Icon from './Icon.astro';
import { asset } from '../lib/site';

const rates = [0.5, 1, 1.5, 2];
---

<section id="demo" class="relative bg-bg py-16">
  <div class="shell">
    <div class="reveal mb-8 flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-[70ch]">
        <p class="label mb-3 text-cyan">Demostración · vídeo</p>
        <h2 class="text-[clamp(1.9rem,4.4vw,3.2rem)]">La cadena, recorrida en pantalla.</h2>
        <p class="mt-5 text-[16px] leading-relaxed text-ink-2 sm:text-[17px]">
          Una sesión real sobre una aplicación local, con la inspección activada y el backend conectado por Node
          Inspector. Reproductor propio: sin cookies, sin seguimiento y sin salir del sitio.
        </p>
      </div>
      <div class="flex items-center gap-[3px]">
        <span class="label bg-surface px-3 py-2 text-ink-3">MP4</span>
        <span class="label bg-surface px-3 py-2 text-ink-3">Local</span>
        <span class="label bg-green px-3 py-2 text-on-accent">Sin telemetría</span>
      </div>
    </div>

    <div id="player" class="reveal relative bg-surface" style="--d: 80ms">
      <div class="flex items-center gap-3 bg-surface-3 px-4 py-2">
        <span class="h-[9px] w-[9px] shrink-0 bg-red" aria-hidden="true"></span>
        <span class="mono truncate text-[11px] text-ink-2">demo · Backend DevTools Desktop</span>
        <span id="player-state" class="label ml-auto shrink-0 text-ink-3">En pausa</span>
      </div>

      <div class="relative bg-void">
        <video
          id="video"
          class="mx-auto max-h-[74vh] w-full"
          preload="metadata"
          playsinline
          poster={asset('demo-poster.jpg')}
          src={asset('video.mp4')}
        ></video>

        <button
          id="video-cover"
          type="button"
          class="absolute inset-0 flex flex-col bg-void"
          aria-label="Reproducir la demostración"
        >
          <img
            src={asset('demo-poster.jpg')}
            alt=""
            aria-hidden="true"
            width={1364}
            height={768}
            decoding="async"
            class="absolute inset-0 h-full w-full object-contain"
          />
          <span data-cover-play class="relative m-auto flex items-center gap-3 bg-blue p-4 text-on-accent sm:px-5">
            <Icon name="play" size={26} />
            <span class="label hidden sm:inline">Reproducir la demostración</span>
          </span>
          <span class="relative flex flex-wrap items-center gap-x-5 gap-y-1 bg-surface px-4 py-3 text-left">
            <span class="mono text-[11px] text-ink-2">00:52 · 1364 × 768 · MP4 local</span>
            <span class="mono text-[11px] text-ink-3">
              El archivo se carga desde este mismo sitio. Nada se envía a un tercero.
            </span>
          </span>
        </button>
      </div>

      <div class="bg-surface-2">
        <div class="relative h-3 bg-surface-3" id="seek-wrap">
          <div id="seek-buffer" class="absolute inset-y-0 left-0 bg-surface-4" style="width: 0%"></div>
          <div id="seek-fill" class="absolute inset-y-0 left-0 bg-blue" style="width: 0%"></div>
          <input
            id="seek"
            type="range"
            min="0"
            max="1000"
            value="0"
            step="1"
            class="absolute inset-0 h-full w-full cursor-pointer appearance-none bg-transparent"
            aria-label="Posición del vídeo"
          />
        </div>

        <div class="flex flex-wrap items-center gap-[3px] p-[3px]">
          <button
            id="video-play"
            type="button"
            class="flex h-11 w-14 items-center justify-center bg-blue text-on-accent hover:bg-ink hover:text-bg"
            aria-label="Reproducir"
          >
            <span data-video-icon><Icon name="play" size={18} /></span>
          </button>

          <button
            id="video-restart"
            type="button"
            class="flex h-11 w-11 items-center justify-center bg-surface text-ink hover:bg-blue hover:text-on-accent"
            aria-label="Volver al inicio"
          >
            <Icon name="reset" size={17} />
          </button>

          <span class="mono flex h-11 items-center bg-surface px-4 text-[12px] text-ink-2">
            <span id="video-time">00:00</span>
            <span class="mx-2 text-ink-3">/</span>
            <span id="video-duration">--:--</span>
          </span>

          <button
            id="video-mute"
            type="button"
            class="flex h-11 items-center gap-2 bg-surface px-4 text-ink hover:bg-blue hover:text-on-accent"
            aria-label="Silenciar"
          >
            <span data-mute-icon><Icon name="volume" size={17} /></span>
            <span class="label hidden sm:inline" data-mute-label>Sonido</span>
          </button>

          <label class="flex h-11 items-center gap-2 bg-surface px-4">
            <span class="label text-ink-3">Velocidad</span>
            <select id="video-rate" class="mono cursor-pointer bg-surface-3 px-2 py-1 text-[12px] text-ink">
              {rates.map((r) => <option value={r} selected={r === 1}>{r}×</option>)}
            </select>
          </label>

          <button
            id="video-full"
            type="button"
            class="ml-auto flex h-11 items-center gap-2 bg-surface px-4 text-ink hover:bg-blue hover:text-on-accent"
            aria-label="Pantalla completa"
          >
            <Icon name="expand" size={17} />
            <span class="label hidden sm:inline">Pantalla completa</span>
          </button>
        </div>
      </div>

      <p class="mono bg-surface px-4 py-3 text-[11px] leading-relaxed text-ink-3">
        Atajos con el reproductor enfocado: <span class="text-ink-2">Espacio</span> reproduce o pausa ·
        <span class="text-ink-2">← →</span> salta 5 s · <span class="text-ink-2">M</span> silencia ·
        <span class="text-ink-2">F</span> pantalla completa.
      </p>
    </div>
  </div>
</section>

<style>
  #seek::-webkit-slider-runnable-track {
    height: 12px;
    background: transparent;
  }
  #seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    background: var(--c-ink);
  }
  #seek::-moz-range-track {
    height: 12px;
    background: transparent;
  }
  #seek::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border: 0;
    background: var(--c-ink);
  }
  #seek:focus-visible {
    background: transparent;
  }
  #seek:focus-visible::-webkit-slider-thumb {
    background: var(--c-amber);
  }
  #seek:focus-visible::-moz-range-thumb {
    background: var(--c-amber);
  }
  #video-cover:hover [data-cover-play] {
    background: var(--c-ink);
    color: var(--c-bg);
  }
</style>

<script>
  const player = document.getElementById('player');
  const video = document.getElementById('video') as HTMLVideoElement | null;
  const cover = document.getElementById('video-cover');
  const playBtn = document.getElementById('video-play');
  const muteBtn = document.getElementById('video-mute');
  const seek = document.getElementById('seek') as HTMLInputElement | null;
  const fill = document.getElementById('seek-fill');
  const buffer = document.getElementById('seek-buffer');
  const timeEl = document.getElementById('video-time');
  const durEl = document.getElementById('video-duration');
  const stateEl = document.getElementById('player-state');
  const rate = document.getElementById('video-rate') as HTMLSelectElement | null;

  const PLAY_ICON =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M7 4l13 8-13 8V4z"/></svg>';
  const PAUSE_ICON =
    '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M8 4v16 M16 4v16"/></svg>';
  const VOL_ICON =
    '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4V9z M17 8.5a5 5 0 0 1 0 7 M20 6a9 9 0 0 1 0 12"/></svg>';
  const MUTE_ICON =
    '<svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 9h4l5-4v14l-5-4H4V9z M17 9l5 6 M22 9l-5 6"/></svg>';

  const fmt = (s: number) => {
    if (!Number.isFinite(s) || s < 0) return '--:--';
    const total = Math.floor(s);
    const m = Math.floor(total / 60);
    const sec = total % 60;
    return `${String(m).padStart(2, '0')}:${String(sec).padStart(2, '0')}`;
  };

  if (video && player) {
    const paintPlay = () => {
      const icon = playBtn?.querySelector('[data-video-icon]');
      if (icon) icon.innerHTML = video.paused ? PLAY_ICON : PAUSE_ICON;
      playBtn?.setAttribute('aria-label', video.paused ? 'Reproducir' : 'Pausar');
      if (stateEl) stateEl.textContent = video.ended ? 'Terminado' : video.paused ? 'En pausa' : 'Reproduciendo';
    };

    const paintMute = () => {
      const icon = muteBtn?.querySelector('[data-mute-icon]');
      const label = muteBtn?.querySelector('[data-mute-label]');
      if (icon) icon.innerHTML = video.muted || video.volume === 0 ? MUTE_ICON : VOL_ICON;
      if (label) label.textContent = video.muted ? 'Silencio' : 'Sonido';
      muteBtn?.setAttribute('aria-label', video.muted ? 'Activar el sonido' : 'Silenciar');
    };

    const paintTime = () => {
      const dur = video.duration;
      const pct = Number.isFinite(dur) && dur > 0 ? (video.currentTime / dur) * 100 : 0;
      if (fill) fill.style.width = `${pct}%`;
      if (seek && document.activeElement !== seek) seek.value = String(Math.round(pct * 10));
      if (timeEl) timeEl.textContent = fmt(video.currentTime);
      if (durEl) durEl.textContent = fmt(dur);
      if (buffer && Number.isFinite(dur) && dur > 0 && video.buffered.length) {
        const end = video.buffered.end(video.buffered.length - 1);
        buffer.style.width = `${Math.min(100, (end / dur) * 100)}%`;
      }
    };

    const toggle = () => {
      if (video.paused) void video.play().catch(() => paintPlay());
      else video.pause();
    };

    cover?.addEventListener('click', () => {
      void video.play().catch(() => {
        cover.hidden = false;
      });
    });

    playBtn?.addEventListener('click', toggle);
    video.addEventListener('click', toggle);

    document.getElementById('video-restart')?.addEventListener('click', () => {
      video.currentTime = 0;
      paintTime();
    });

    muteBtn?.addEventListener('click', () => {
      video.muted = !video.muted;
      paintMute();
    });

    rate?.addEventListener('change', () => {
      video.playbackRate = Number(rate.value) || 1;
    });

    seek?.addEventListener('input', () => {
      if (!Number.isFinite(video.duration) || video.duration <= 0) return;
      video.currentTime = (Number(seek.value) / 1000) * video.duration;
      if (fill) fill.style.width = `${Number(seek.value) / 10}%`;
      if (timeEl) timeEl.textContent = fmt(video.currentTime);
    });

    document.getElementById('video-full')?.addEventListener('click', () => {
      if (document.fullscreenElement) void document.exitFullscreen().catch(() => {});
      else void player.requestFullscreen?.().catch(() => {});
    });

    player.addEventListener('keydown', (e) => {
      const tag = (e.target as HTMLElement)?.tagName;
      if (tag === 'SELECT' || tag === 'INPUT') return;
      if (e.key === ' ' || e.key.toLowerCase() === 'k') {
        e.preventDefault();
        toggle();
      }
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        video.currentTime = Math.min(video.duration || 0, video.currentTime + 5);
      }
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        video.currentTime = Math.max(0, video.currentTime - 5);
      }
      if (e.key.toLowerCase() === 'm') {
        video.muted = !video.muted;
        paintMute();
      }
      if (e.key.toLowerCase() === 'f') {
        if (document.fullscreenElement) void document.exitFullscreen().catch(() => {});
        else void player.requestFullscreen?.().catch(() => {});
      }
    });

    const paintCover = () => {
      if (cover && !video.paused) cover.hidden = true;
    };

    ['play', 'playing', 'pause', 'ended'].forEach((evt) =>
      video.addEventListener(evt, () => {
        paintPlay();
        paintCover();
      }),
    );
    ['timeupdate', 'loadedmetadata', 'durationchange', 'progress'].forEach((evt) =>
      video.addEventListener(evt, paintTime),
    );
    video.addEventListener('volumechange', paintMute);
    video.addEventListener('error', () => {
      if (stateEl) stateEl.textContent = 'No se pudo cargar';
      if (cover) cover.hidden = false;
    });

    paintPlay();
    paintMute();
    paintTime();
  }
</script>